{
  "name": "@oclkadev/node-starter",
  "version": "0.2.0",
  "description": "Fast TS starter for Node.js libraries and CLI tools.",
  "keywords": [
    "node",
    "nodejs",
    "typescript",
    "starter",
    "template",
    "boilerplate",
    "scaffold",
    "library",
    "cli",
    "cli-app",
    "esm",
    "cjs",
    "tsup",
    "pnpm",
    "command-line",
    "terminal"
  ],
  "homepage": "https://github.com/oclkadev/node-starter#readme",
  "bugs": {
    "url": "https://github.com/oclkadev/node-starter/issues"
  },
  "license": "MIT",
  "author": {
    "name": "oclkadev",
    "email": "hello@oclka.dev",
    "url": "https://oclka.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oclkadev/node-starter.git"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "node-starter": "./dist/index.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsup src/index.ts",
    "dev": "NODE_ENV=development tsx src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint '**/*.md' --fix --ignore node_modules --ignore dist",
    "check:all": "pnpm check:fast && pnpm check:spell && pnpm lint:md && pnpm check:secrets && pnpm build  && pnpm check:size && pnpm check:build && true",
    "check:fast": "pnpm check:types && pnpm lint:fix && pnpm knip && true",
    "check:secrets": "gitleaks protect --staged --verbose",
    "check:types": "tsc --noEmit",
    "check:spell": "cspell '**/*.{ts,md,json,yml,yaml}' --no-progress --gitignore",
    "check:build": "publint && attw --pack",
    "check:size": "size-limit",
    "format": "prettier --write .",
    "gen:docs": "typedoc",
    "knip": "knip --config knip.config.mjs",
    "prepare": "husky",
    "commit": "cz",
    "release": "pnpm build && changeset publish"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ],
    "*.md": [
      "markdownlint --fix"
    ],
    "*.{ts,json,md,yml,yaml}": [
      "prettier --write",
      "cspell --no-must-find-files"
    ]
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/node": "^26.1.2",
    "commitizen": "^4.3.2",
    "commitlint": "^21.2.1",
    "cspell": "^10.0.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-unicorn": "^73.0.0",
    "gitleaks": "^1.0.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "knip": "^6.32.0",
    "lint-staged": "^17.3.0",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "size-limit": "^13.0.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.9",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.20.0",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
